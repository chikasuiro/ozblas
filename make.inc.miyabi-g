##############################################
# make.inc for Miyabi-G (NVIDIA GH200, AArch64) with NVIDIA HPC SDK (nvc++)
# usage: module purge; module load nvidia/<version>; cp make.inc.miyabi-g make.inc
#        then set LIB_PATH and INC_PATH (OpenBLAS)

#--- System ----------------------------------
#CPU_ARCH: KNL, ICELAKE, SKYLAKE, ARM
CPU_ARCH = ARM
# -> If specified, compile with architecture-specific options

#LINKAGE: static, dynamic
LINKAGE = static

#--- PATH ------------------------------------
CUDA_PATH	= $(NVHPC_ROOT)/cuda
# -> NVHPC_ROOT is set by 'module load nvidia/<version>'; CUDA_PATH is used only to locate nvcc
#    (cuBLAS and cuSPARSE headers/libraries are found via CPATH/LIBRARY_PATH set by the module)
LIB_PATH	= $(HOME)/local/lib
INC_PATH	= $(HOME)/local/include
# -> installation path of external libraries
# -> multiple directories can be specified separated by ':'

#--- Compiler --------------------------------
CXX = nvc++

#--- CPU (OzBLAS) / CUDA (cuOzBLAS) ----------
CPU  = yes
CUDA = yes
# CPU must be yes also for CUDA

#--- BLAS (CPU) ------------------------------
#CPU_BLAS: OpenBLAS, MKL
#CPU_BLAS = MKL
CPU_BLAS = OpenBLAS
# CSRMV & CG require MKL because OpenBLAS does not have sparse routines.

#--- MPLAPACK (for testing) ------------------
MPLAPACK = no
# -> yes or no. 'yes' uses MPLAPACK for verifying computational result
# -> If no, binary128 (PREC_Q_D and PREC_Q_S) cannot be used.

#--- CUDA Compute Capability -----------------
CC50 = no
CC52 = no
CC53 = no
CC60 = no
CC61 = no
CC62 = no
CC70 = no
CC75 = no
CC80 = no
CC86 = no
CC90 = yes
# -> GH200 is CC90

#--- Precision -------------------------------
# PREC_X_Y: X is I/O-precision, Y is compute-precision
# Q: FP128, D: FP64, S: FP32, H: FP16 
PREC_Q_D = yes
PREC_Q_S = yes
PREC_D_D = yes
PREC_D_S = yes
PREC_D_H = yes
PREC_S_S = yes
PREC_S_H = yes
PREC_S_D = yes
# -> D_H and S_H: GPU only
# -> Q_D and Q_S: CPU only

#--- Routine ---------------------------------
# level-1
DOT = yes
NRM2 = yes
AXPY = yes

# level-2
GEMV = yes
CSRMV = yes
# -> CSRMV requires MKL on CPUs

# level-3
GEMM = yes

# solver
CG = yes
# -> CG requires CSRMV, DOT, NRM2, and AXPY

##############################################

